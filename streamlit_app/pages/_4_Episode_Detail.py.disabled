"""
PodcastIQ — Episode Detail
Per-episode summary, participants, claims, and related episodes.
"""

import os
import sys
import streamlit as st
from collections import Counter

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.path.insert(0, ROOT)

st.set_page_config(
    page_title="Episode Detail · PodcastIQ",
    page_icon="🎙️",
    layout="wide",
    initial_sidebar_state="collapsed",
)

_css_path = os.path.join(os.path.dirname(os.path.dirname(__file__)), "components", "styles.css")
with open(_css_path, encoding="utf-8") as f:
    st.markdown(f"<style>{f.read()}</style>", unsafe_allow_html=True)

# ── Navbar ────────────────────────────────────────────────────────────────────
from components.navbar import render_navbar
render_navbar()

from components.snowflake_queries import (
    search_episodes, get_episode_summary, get_episode_participants,
    get_episode_claims,
)

CLAIM_TYPE_ICONS = {
    "VERIFIABLE_FACT": "📌",
    "PREDICTION":      "🔮",
    "OPINION":         "💬",
    "STATISTICAL":     "📊",
}

# ── Header ────────────────────────────────────────────────────────────────────
st.markdown('<div class="page-title">Episode Detail</div>', unsafe_allow_html=True)
st.markdown(
    '<div class="page-subtitle">Explore episode summaries, participants, and extracted claims.</div>',
    unsafe_allow_html=True,
)

# ── Search ────────────────────────────────────────────────────────────────────
search_col, btn_col = st.columns([5, 1])

with search_col:
    ep_search = st.text_input(
        "Search episodes",
        placeholder="Search by title, guest name, or topic...",
        label_visibility="collapsed",
        value=st.session_state.get("ep_search_val", ""),
    )
with btn_col:
    do_search = st.button("Search", use_container_width=True)

# ── Search results ────────────────────────────────────────────────────────────
selected_video_id = st.session_state.get("selected_video_id")

# Only show search results when no episode is selected
if not selected_video_id and ep_search and (do_search or ep_search != st.session_state.get("_last_ep_search", "")):
    st.session_state["_last_ep_search"] = ep_search
    with st.spinner(f'Searching for "{ep_search}"...'):
        results = search_episodes(ep_search)

    if not results:
        st.info("No episodes found. Try a different search term.")
    else:
        # Deduplicate by (title, channel) before rendering
        seen_eps: set = set()
        deduped_results = []
        for r in results:
            key = (r.get("EPISODE_TITLE", ""), r.get("CHANNEL_NAME", ""))
            if key not in seen_eps:
                seen_eps.add(key)
                deduped_results.append(r)

        st.markdown(
            f'<div class="section-label">{len(deduped_results)} episodes found</div>',
            unsafe_allow_html=True,
        )
        for i, r in enumerate(deduped_results[:10]):
            vid   = r.get("VIDEO_ID", "") or f"ep_{i}"
            title = r.get("EPISODE_TITLE", "Unknown")
            chan  = r.get("CHANNEL_NAME", "")
            date  = str(r.get("PUBLISH_DATE", ""))[:10]
            url   = r.get("YOUTUBE_URL", "")

            col_info, col_btn = st.columns([7, 1])
            with col_info:
                yt = f'<a class="rc-link" href="{url}" target="_blank">▶ YouTube</a>' if url else ""
                st.markdown(f"""
<div style="padding:0.55rem 0;border-bottom:1px solid rgba(255,255,255,.04);">
  <div style="font-size:0.875rem;font-weight:600;color:#e2e8f0;margin-bottom:0.2rem;">{title}</div>
  <div style="font-size:0.75rem;color:#475569;">{chan} &nbsp;·&nbsp; {date} &nbsp; {yt}</div>
</div>""", unsafe_allow_html=True)
            with col_btn:
                if st.button("View", key=f"view_{i}_{vid}"):
                    st.session_state["selected_video_id"]  = vid
                    st.session_state["selected_ep_title"]  = title
                    st.rerun()

# ── Episode detail view ───────────────────────────────────────────────────────
if selected_video_id:
    col_ep_h, col_ep_x = st.columns([8, 1])
    with col_ep_x:
        if st.button("✕ Close", key="close_ep"):
            del st.session_state["selected_video_id"]
            st.session_state.pop("selected_ep_title", None)
            st.rerun()

    st.markdown('<div class="hr"></div>', unsafe_allow_html=True)

    st.markdown(f'<div style="font-size:.7rem;color:#475569;">DEBUG video_id: `{selected_video_id}`</div>', unsafe_allow_html=True)

    with st.spinner("Loading episode data..."):
        summary_row  = get_episode_summary(selected_video_id)
        participants = get_episode_participants(selected_video_id)
        claims       = get_episode_claims(selected_video_id, 60)

    st.markdown(f'<div style="font-size:.7rem;color:#475569;">DEBUG summary={bool(summary_row)} participants={len(participants)} claims={len(claims)}</div>', unsafe_allow_html=True)

    if not summary_row and not claims and not participants:
        st.warning("No detail data found for this episode. The episode may not have been fully processed yet.")
        st.stop()

    st.markdown(
        f'<div style="font-size:.75rem;color:#64748b;margin-bottom:.5rem;">'
        f'{len(claims)} claims · {len(participants)} participants</div>',
        unsafe_allow_html=True,
    )

    # ── Episode header ─────────────────────────────────────────────────────────
    ep_title   = (summary_row or {}).get("EPISODE_TITLE") or st.session_state.get("selected_ep_title", "Episode")
    ep_channel = (summary_row or {}).get("CHANNEL_NAME", "")
    ep_date    = str((summary_row or {}).get("PUBLISH_DATE", ""))[:10]

    st.markdown(f"""
<div style="margin-bottom:1.4rem;padding:1.2rem 1.4rem;
  background:linear-gradient(135deg,rgba(109,40,217,.08),rgba(168,85,247,.04));
  border:1px solid rgba(109,40,217,.18);border-radius:1rem;position:relative;overflow:hidden;">
  <div style="position:absolute;top:0;left:0;right:0;height:2px;
    background:linear-gradient(90deg,#6d28d9,#a855f7,#ec4899);"></div>
  <div style="font-size:1.2rem;font-weight:700;color:#e2e8f0;line-height:1.3;margin-bottom:0.3rem;">
    {ep_title}
  </div>
  <div style="font-size:0.8rem;color:#64748b;">{ep_channel} &nbsp;·&nbsp; {ep_date}</div>
</div>
""", unsafe_allow_html=True)

    col_main, col_side = st.columns([3, 1])

    with col_main:
        # ── Summary ───────────────────────────────────────────────────────────
        if summary_row and summary_row.get("SUMMARY_TEXT"):
            st.markdown('<div class="section-label">Episode Summary</div>', unsafe_allow_html=True)
            st.markdown(f"""
<div class="assistant-bubble" style="font-size:0.9rem;line-height:1.75;border-radius:0.9rem;">
  {summary_row["SUMMARY_TEXT"]}
</div>""", unsafe_allow_html=True)
        else:
            st.info("No summary available for this episode.")

        # ── Claims ────────────────────────────────────────────────────────────
        if claims:
            st.markdown("<br>", unsafe_allow_html=True)
            st.markdown('<div class="section-label">Extracted Claims</div>', unsafe_allow_html=True)

            claim_types   = ["All"] + sorted({c.get("CLAIM_TYPE", "") for c in claims if c.get("CLAIM_TYPE")})
            type_filter   = st.selectbox("Claim type", claim_types, label_visibility="collapsed")

            filtered_claims = [
                c for c in claims
                if type_filter == "All" or c.get("CLAIM_TYPE") == type_filter
            ]

            st.markdown(
                f'<div style="font-size:0.72rem;color:#475569;margin-bottom:0.6rem;">'
                f'Showing {len(filtered_claims[:30])} of {len(filtered_claims)} claims</div>',
                unsafe_allow_html=True,
            )

            for claim in filtered_claims[:30]:
                ctext     = claim.get("CLAIM_TEXT", "")
                speaker   = claim.get("SPEAKER", "Unknown")
                ctype     = claim.get("CLAIM_TYPE", "")
                topic     = claim.get("TOPIC", "")
                url       = claim.get("YOUTUBE_URL", "")
                type_icon = CLAIM_TYPE_ICONS.get(ctype, "💬")
                ct_label  = ctype.replace("_", " ").title() if ctype else ""
                link_html = (
                    f"<a class='rc-link' href='{url}' target='_blank'>▶ Watch →</a>"
                    if url else ""
                )
                topic_html = (
                    f'<span style="font-size:0.7rem;color:#475569;">· {topic[:40]}</span>'
                    if topic else ""
                )

                st.markdown(f"""
<div class="result-card">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.45rem;">
    <div style="display:flex;align-items:center;gap:0.4rem;flex-wrap:wrap;">
      <span style="font-size:0.85rem;">{type_icon}</span>
      <span style="font-size:0.8rem;font-weight:600;color:#e2e8f0;">{speaker}</span>
      {topic_html}
    </div>
    <span style="font-size:0.7rem;color:#64748b;">{ct_label}</span>
  </div>
  <div style="font-size:0.85rem;color:#94a3b8;line-height:1.62;">{ctext}</div>
  {f'<div style="margin-top:0.45rem;">{link_html}</div>' if link_html else ""}
</div>""", unsafe_allow_html=True)

            if len(filtered_claims) > 30:
                st.markdown(
                    f'<div style="font-size:0.78rem;color:#475569;text-align:center;padding:0.5rem;">'
                    f'Showing first 30 of {len(filtered_claims)} claims</div>',
                    unsafe_allow_html=True,
                )

    with col_side:
        # ── Participants ───────────────────────────────────────────────────────
        st.markdown('<div class="section-label">Participants</div>', unsafe_allow_html=True)
        if participants:
            for p in participants:
                name       = p.get("PARTICIPANT_NAME", "")
                role       = p.get("PARTICIPANT_ROLE", "")
                role_color = "#a78bfa" if role == "HOST" else "#64748b"
                st.markdown(f"""
<div style="display:flex;align-items:center;gap:0.5rem;padding:0.45rem 0;
  border-bottom:1px solid rgba(255,255,255,.04);">
  <div style="width:32px;height:32px;border-radius:50%;
    background:rgba(109,40,217,.15);border:1px solid rgba(109,40,217,.25);
    display:flex;align-items:center;justify-content:center;
    font-size:0.875rem;font-weight:700;color:#a78bfa;flex-shrink:0;">
    {name[0].upper() if name else "?"}
  </div>
  <div>
    <div style="font-size:0.825rem;font-weight:600;color:#e2e8f0;">{name}</div>
    <div style="font-size:0.7rem;color:{role_color};font-weight:500;">{role}</div>
  </div>
</div>""", unsafe_allow_html=True)
        else:
            st.markdown('<div style="font-size:0.825rem;color:#475569;">No participant data</div>',
                        unsafe_allow_html=True)

        # ── Claim breakdown ────────────────────────────────────────────────────
        if claims:
            st.markdown("<br>", unsafe_allow_html=True)
            st.markdown('<div class="section-label">Claim Breakdown</div>', unsafe_allow_html=True)

            type_counts = Counter(c.get("CLAIM_TYPE", "Unknown") for c in claims)

            for ctype, count in type_counts.most_common():
                icon = CLAIM_TYPE_ICONS.get(ctype, "💬")
                st.markdown(
                    f'<div style="display:flex;justify-content:space-between;'
                    f'font-size:0.8rem;color:#64748b;padding:0.22rem 0;">'
                    f'<span>{icon} {ctype.replace("_", " ").title()}</span>'
                    f'<b style="color:#94a3b8;">{count}</b></div>',
                    unsafe_allow_html=True,
                )

elif not ep_search:
    st.markdown("""
<div style="text-align:center;padding:4rem 0;">
  <div style="font-size:2.5rem;margin-bottom:0.75rem;">🎙️</div>
  <div style="font-size:1rem;font-weight:600;
    background:linear-gradient(135deg,#fff,#c4b5fd,#a855f7);
    -webkit-background-clip:text;-webkit-text-fill-color:transparent;
    background-clip:text;margin-bottom:0.5rem;">
    Search for an episode to explore its content
  </div>
  <div style="font-size:0.875rem;color:#475569;">
    Try: <span style="color:#7c3aed;">Sam Altman</span> &nbsp;·&nbsp;
         <span style="color:#7c3aed;">longevity</span> &nbsp;·&nbsp;
         <span style="color:#7c3aed;">All-In</span> &nbsp;·&nbsp;
         <span style="color:#7c3aed;">Lex Fridman</span>
  </div>
</div>
""", unsafe_allow_html=True)
