/* ── PodcastIQ — Dark Purple Theme ────────────────────────────────────────── */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

*, *::before, *::after {
    box-sizing: border-box;
    font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
}

/* ── Base ── */
html, body,
[data-testid="stAppViewContainer"],
[data-testid="stAppViewContainer"] > .main,
[data-testid="block-container"] {
    background: #07070f !important;
    color: #dde1ea !important;
}

/* ── Hide Streamlit chrome ── */
#MainMenu, footer, header            { visibility: hidden !important; }
[data-testid="stToolbar"]            { display: none !important; }
[data-testid="stDecoration"]         { display: none !important; }
[data-testid="stStatusWidget"]       { display: none !important; }
[data-testid="manage-app-button"]    { display: none !important; }

/* ── Hide auto-generated page nav ── */
[data-testid="stSidebarNav"]  { display: none !important; }

/* ════════════════════════════════════════════
   SIDEBAR CLOSE BUTTON  (‹  inside the sidebar)
   Target the button directly — leave it clickable
   ════════════════════════════════════════════ */
button[aria-label="Close sidebar"],
[data-testid="stSidebarCollapseButton"] button {
    background: transparent !important;
    border: 1px solid rgba(255,255,255,.08) !important;
    border-radius: 6px !important;
    box-shadow: none !important;
    width: 28px !important;
    height: 28px !important;
    padding: 0 !important;
    cursor: pointer !important;
    position: relative !important;
    overflow: hidden !important;
    transition: border-color .2s, background .2s !important;
}
button[aria-label="Close sidebar"]:hover,
[data-testid="stSidebarCollapseButton"] button:hover {
    background: rgba(109,40,217,.12) !important;
    border-color: rgba(109,40,217,.4) !important;
}
/* Hide the broken icon (SVG + span) without removing the button */
button[aria-label="Close sidebar"] svg,
[data-testid="stSidebarCollapseButton"] button svg { display: none !important; }
button[aria-label="Close sidebar"] span,
[data-testid="stSidebarCollapseButton"] button span { font-size: 0 !important; width: 0 !important; }
/* Proper ‹ arrow via ::after */
button[aria-label="Close sidebar"]::after,
[data-testid="stSidebarCollapseButton"] button::after {
    content: '‹' !important;
    position: absolute !important;
    inset: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #64748b !important;
    font-size: 1.25rem !important;
    font-weight: 700 !important;
    font-family: 'Inter', system-ui, sans-serif !important;
    pointer-events: none !important;
}
button[aria-label="Close sidebar"]:hover::after,
[data-testid="stSidebarCollapseButton"] button:hover::after { color: #a78bfa !important; }

/* ════════════════════════════════════════════
   SIDEBAR OPEN BUTTON (›  left-edge tab)
   Target the BUTTON inside collapsedControl
   ════════════════════════════════════════════ */
[data-testid="collapsedControl"] button,
button[aria-label="Open sidebar"] {
    background: #0d0d1a !important;
    border: 1px solid rgba(109,40,217,.45) !important;
    border-left: none !important;
    border-radius: 0 10px 10px 0 !important;
    box-shadow: 2px 0 12px rgba(109,40,217,.2) !important;
    width: 26px !important;
    height: 56px !important;
    padding: 0 !important;
    cursor: pointer !important;
    position: relative !important;
    overflow: hidden !important;
    transition: background .2s, border-color .2s, box-shadow .2s !important;
}
[data-testid="collapsedControl"] button:hover,
button[aria-label="Open sidebar"]:hover {
    background: rgba(109,40,217,.2) !important;
    border-color: rgba(109,40,217,.7) !important;
    box-shadow: 2px 0 18px rgba(109,40,217,.35) !important;
}
/* Hide broken icon */
[data-testid="collapsedControl"] button svg,
button[aria-label="Open sidebar"] svg { display: none !important; }
[data-testid="collapsedControl"] button span,
button[aria-label="Open sidebar"] span { font-size: 0 !important; width: 0 !important; }
/* Proper › arrow */
[data-testid="collapsedControl"] button::after,
button[aria-label="Open sidebar"]::after {
    content: '›' !important;
    position: absolute !important;
    inset: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #a78bfa !important;
    font-size: 1.3rem !important;
    font-weight: 700 !important;
    font-family: 'Inter', system-ui, sans-serif !important;
    pointer-events: none !important;
}
[data-testid="collapsedControl"] button:hover::after,
button[aria-label="Open sidebar"]:hover::after { color: #c4b5fd !important; }

/* ── Scrollbar ── */
::-webkit-scrollbar                  { width: 5px; height: 5px; }
::-webkit-scrollbar-track            { background: #0d0d1a; }
::-webkit-scrollbar-thumb            { background: #4c1d95; border-radius: 3px; }

/* ── Container — zero top gap so the navbar sits flush ── */
.main > .block-container,
[data-testid="block-container"] {
    padding-top: 0 !important;
    padding-bottom: 3rem !important;
    max-width: 1200px !important;
}

/* ── Hide sidebar completely — navigation is in the top bar ── */
section[data-testid="stSidebar"],
[data-testid="stSidebar"],
[data-testid="collapsedControl"],
button[aria-label="Close sidebar"],
button[aria-label="Open sidebar"],
[data-testid="stSidebarCollapseButton"] { display: none !important; }

/* ── Top navigation bar ── */
.nav-logo {
    font-size: 1rem;
    font-weight: 800;
    background: linear-gradient(135deg, #fff 0%, #c4b5fd 45%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    padding: 0.45rem 0;
    white-space: nowrap;
    letter-spacing: -0.01em;
}

.nav-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.07), transparent);
    margin: 0.6rem 0 1.6rem;
}

/* Page-link elements used as nav tabs */
[data-testid="stPageLink-NavLink"] {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: rgba(255,255,255,.03) !important;
    border: 1px solid rgba(255,255,255,.06) !important;
    border-radius: 0.65rem !important;
    padding: 0.42rem 0.5rem !important;
    text-decoration: none !important;
    transition: all .15s !important;
    width: 100% !important;
}
[data-testid="stPageLink-NavLink"] p {
    color: #64748b !important;
    font-size: 0.82rem !important;
    font-weight: 500 !important;
    margin: 0 !important;
    white-space: nowrap !important;
}
[data-testid="stPageLink-NavLink"]:hover {
    background: rgba(109,40,217,.1) !important;
    border-color: rgba(109,40,217,.28) !important;
}
[data-testid="stPageLink-NavLink"]:hover p { color: #c4b5fd !important; }

[data-testid="stPageLink-NavLink"][aria-current="page"] {
    background: rgba(109,40,217,.18) !important;
    border-color: rgba(109,40,217,.42) !important;
}
[data-testid="stPageLink-NavLink"][aria-current="page"] p {
    color: #e9d5ff !important;
    font-weight: 600 !important;
}

/* ── Page header (gradient title) ── */
.page-title {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 800;
    background: linear-gradient(135deg, #ffffff 0%, #c4b5fd 45%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
    margin-bottom: 0.4rem;
    letter-spacing: -0.01em;
}
.page-subtitle {
    font-size: 0.9rem;
    color: #64748b;
    margin-bottom: 2rem;
    line-height: 1.6;
}

/* ── Hero (chat page) ── */
.hero-wrap {
    text-align: center;
    padding: 2.4rem 1rem 1.2rem;
}
.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: linear-gradient(135deg, rgba(109,40,217,.18), rgba(168,85,247,.12));
    border: 1px solid rgba(109,40,217,.35);
    border-radius: 2rem;
    padding: .28rem 1rem;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #a78bfa;
    margin-bottom: .9rem;
}
.hero-title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 800;
    background: linear-gradient(135deg, #ffffff 0%, #c4b5fd 45%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.15;
    margin-bottom: .65rem;
    letter-spacing: -.01em;
}
.hero-sub {
    font-size: .92rem;
    color: #64748b;
    max-width: 540px;
    margin: 0 auto 1.8rem;
    line-height: 1.7;
}

/* ── Section label ── */
.section-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #334155;
    margin-bottom: 0.9rem;
    margin-top: 1.4rem;
}

/* ── HR ── */
.hr {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.07), transparent);
    margin: 1.8rem 0;
}

/* ── Cards ── */
.result-card {
    background: rgba(255,255,255,.025);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 0.9rem;
    padding: 1.1rem 1.2rem;
    margin-bottom: 0.65rem;
    transition: border-color 0.2s;
}
.result-card:hover { border-color: rgba(109,40,217,.3); }

.rc-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #e2e8f0;
    margin-bottom: 0.2rem;
    line-height: 1.35;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}
.rc-meta {
    font-size: 0.72rem;
    color: #475569;
    margin-bottom: 0.5rem;
}
.rc-text {
    font-size: 0.825rem;
    color: #94a3b8;
    line-height: 1.65;
    margin-bottom: 0.5rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
}
.rc-link {
    font-size: 0.775rem;
    color: #7c3aed;
    text-decoration: none;
    font-weight: 500;
}
.rc-link:hover { color: #a855f7; text-decoration: underline; }

/* also used inline as result-card-link */
.result-card-link {
    font-size: 0.75rem;
    color: #7c3aed;
    text-decoration: none;
}
.result-card-link:hover { color: #a855f7; }

/* ── Episode card ── */
.episode-card {
    background: rgba(255,255,255,.025);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 0.9rem;
    padding: 0.875rem 1rem;
    margin-bottom: 0.5rem;
    transition: border-color 0.2s;
}
.episode-card:hover { border-color: rgba(109,40,217,.3); }

/* ── Stat tiles ── */
.stat-tile {
    background: rgba(255,255,255,.025);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 0.9rem;
    padding: 1.1rem 1rem;
    text-align: center;
}
.stat-tile-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: #c4b5fd;
    line-height: 1;
    margin-bottom: 0.3rem;
}
.stat-tile-label {
    font-size: 0.65rem;
    color: #475569;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}
/* alias used in app sidebar */
.stat-value  { font-size: 1rem; font-weight: 700; color: #c4b5fd; line-height: 1; }
.stat-label  { font-size: 0.62rem; color: #334155; text-transform: uppercase; letter-spacing: 0.09em; font-weight: 600; }

/* ── Badges ── */
.badge {
    display: inline-block;
    padding: 0.18rem 0.55rem;
    border-radius: 20px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
}
.badge-verified      { background: rgba(16,185,129,.15);  color: #6ee7b7; border: 1px solid rgba(16,185,129,.3); }
.badge-false         { background: rgba(239,68,68,.12);   color: #fca5a5; border: 1px solid rgba(239,68,68,.25); }
.badge-outdated,
.badge-disputed      { background: rgba(245,158,11,.12);  color: #fcd34d; border: 1px solid rgba(245,158,11,.25); }
.badge-unverified    { background: rgba(255,255,255,.05); color: #94a3b8; border: 1px solid rgba(255,255,255,.1); }
.badge-pending       { background: rgba(99,102,241,.12);  color: #a5b4fc; border: 1px solid rgba(99,102,241,.25); }
.badge-contradicted  { background: rgba(239,68,68,.12);   color: #fca5a5; border: 1px solid rgba(239,68,68,.25); }
.badge-revised       { background: rgba(245,158,11,.12);  color: #fcd34d; border: 1px solid rgba(245,158,11,.25); }
.badge-confirmed     { background: rgba(16,185,129,.15);  color: #6ee7b7; border: 1px solid rgba(16,185,129,.3); }
.badge-softened      { background: rgba(99,102,241,.12);  color: #a5b4fc; border: 1px solid rgba(99,102,241,.25); }
.badge-escalated     { background: rgba(236,72,153,.12);  color: #f9a8d4; border: 1px solid rgba(236,72,153,.25); }

/* ── Chat bubbles ── */
.user-bubble {
    background: linear-gradient(135deg, rgba(109,40,217,.2), rgba(168,85,247,.12));
    border: 1px solid rgba(109,40,217,.32);
    border-radius: 18px 18px 4px 18px;
    padding: 0.75rem 1.1rem;
    font-size: 0.9rem;
    color: #e9d5ff;
    line-height: 1.6;
    display: inline-block;
    max-width: 78%;
    float: right;
    clear: both;
    margin-bottom: 1rem;
}
.user-row { overflow: hidden; margin-bottom: 1rem; }

.assistant-bubble {
    background: rgba(255,255,255,.025);
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 4px 18px 18px 18px;
    padding: 1rem 1.25rem;
    font-size: 0.9rem;
    color: #cbd5e1;
    line-height: 1.75;
    margin-bottom: 0.75rem;
}

/* ── Thinking animation ── */
.thinking-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0.875rem 1rem;
    background: rgba(255,255,255,.025);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 10px;
    margin-bottom: 1rem;
}
.dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #7c3aed;
    animation: bounce 1.2s ease-in-out infinite;
}
.dot:nth-child(2) { animation-delay: 0.15s; }
.dot:nth-child(3) { animation-delay: 0.30s; }
@keyframes bounce {
    0%, 80%, 100% { transform: scale(0.7); opacity: 0.4; }
    40%            { transform: scale(1);   opacity: 1;   }
}
.thinking-text { font-size: 0.85rem; color: #64748b; font-weight: 400; }

/* ── Agent tag ── */
.agent-tag {
    font-size: 0.68rem;
    color: #475569;
    margin-top: 0.5rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 4px;
}

/* ── Claim cards ── */
.claim-card {
    background: rgba(255,255,255,.025);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 0.9rem;
    padding: 0.875rem 1rem;
    font-size: 0.825rem;
    color: #94a3b8;
    line-height: 1.65;
    height: 100%;
}
.claim-meta {
    font-size: 0.7rem;
    color: #475569;
    margin-top: 0.5rem;
}

/* ── Suggestion / generic buttons ── */
[data-testid="stButton"] > button {
    background: rgba(255,255,255,.03) !important;
    border: 1px solid rgba(255,255,255,.08) !important;
    color: #94a3b8 !important;
    border-radius: 0.8rem !important;
    padding: 0.625rem 1rem !important;
    font-size: 0.85rem !important;
    font-weight: 400 !important;
    text-align: left !important;
    width: 100% !important;
    transition: all 0.15s ease !important;
    box-shadow: none !important;
    line-height: 1.4 !important;
    font-family: 'Inter', sans-serif !important;
}
[data-testid="stButton"] > button:hover {
    background: rgba(109,40,217,.08) !important;
    border-color: rgba(109,40,217,.3) !important;
    color: #c4b5fd !important;
    transform: translateY(-1px) !important;
}

/* ── Chat input ── */
[data-testid="stChatInput"] textarea,
[data-testid="stChatInput"] > div {
    border-radius: 0.9rem !important;
    border: 1px solid rgba(255,255,255,.09) !important;
    background: rgba(255,255,255,.04) !important;
    font-size: 0.9rem !important;
    color: #f1f5f9 !important;
}
[data-testid="stChatInput"]:focus-within > div {
    border-color: rgba(109,40,217,.5) !important;
    box-shadow: 0 0 0 3px rgba(109,40,217,.12) !important;
}
[data-testid="stChatInput"] textarea::placeholder { color: #334155 !important; }

/* ── Text inputs ── */
[data-testid="stTextInput"] > div > div > input {
    background: rgba(255,255,255,.04) !important;
    border: 1px solid rgba(255,255,255,.09) !important;
    border-radius: 0.75rem !important;
    color: #f1f5f9 !important;
    font-size: 0.9rem !important;
    padding: 0.7rem 1rem !important;
    transition: border-color 0.2s, box-shadow 0.2s !important;
}
[data-testid="stTextInput"] > div > div > input:focus {
    border-color: rgba(109,40,217,.65) !important;
    box-shadow: 0 0 0 3px rgba(109,40,217,.14) !important;
}
[data-testid="stTextInput"] > div > div > input::placeholder { color: #334155 !important; }
[data-testid="stTextInput"] > div > div { background: transparent !important; }
[data-testid="stTextInput"] label { color: #64748b !important; font-size: 0.82rem !important; }

/* ── Selectbox ── */
[data-testid="stSelectbox"] > div > div {
    background: rgba(255,255,255,.04) !important;
    border: 1px solid rgba(255,255,255,.09) !important;
    border-radius: 0.75rem !important;
    color: #f1f5f9 !important;
}
[data-testid="stSelectbox"] label { color: #64748b !important; font-size: 0.82rem !important; }

/* ── Status ── */
[data-testid="stStatusContainer"] {
    background: rgba(255,255,255,.03) !important;
    border: 1px solid rgba(255,255,255,.07) !important;
    border-radius: 0.85rem !important;
    color: #94a3b8 !important;
}

/* ── Expander ── */
[data-testid="stExpander"] {
    background: rgba(255,255,255,.025) !important;
    border: 1px solid rgba(255,255,255,.06) !important;
    border-radius: 0.85rem !important;
}
[data-testid="stExpanderToggleIcon"] { color: #6d28d9 !important; }

/* ── Spinner ── */
[data-testid="stSpinner"] > div { color: #a78bfa !important; }

/* ── Dataframe ── */
[data-testid="stDataFrame"] {
    border-radius: 0.9rem !important;
    overflow: hidden !important;
}

/* ── Alerts ── */
[data-testid="stInfo"] {
    background: rgba(59,130,246,.07) !important;
    border: 1px solid rgba(59,130,246,.2) !important;
    border-radius: 0.75rem !important;
    color: #93c5fd !important;
}
[data-testid="stWarning"] {
    background: rgba(245,158,11,.07) !important;
    border: 1px solid rgba(245,158,11,.2) !important;
    border-radius: 0.75rem !important;
    color: #fcd34d !important;
}
[data-testid="stError"] {
    background: rgba(239,68,68,.07) !important;
    border: 1px solid rgba(239,68,68,.2) !important;
    border-radius: 0.75rem !important;
    color: #fca5a5 !important;
}
