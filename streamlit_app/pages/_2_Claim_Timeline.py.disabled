"""
PodcastIQ — Claim Timeline
Visualizes how claims evolve over time using Plotly.
"""

import os
import sys
import streamlit as st
import plotly.graph_objects as go
import pandas as pd

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.path.insert(0, ROOT)

st.set_page_config(
    page_title="Claim Timeline · PodcastIQ",
    page_icon="⏳",
    layout="wide",
    initial_sidebar_state="collapsed",
)

_css_path = os.path.join(os.path.dirname(os.path.dirname(__file__)), "components", "styles.css")
with open(_css_path, encoding="utf-8") as f:
    st.markdown(f"<style>{f.read()}</style>", unsafe_allow_html=True)

# ── Navbar ────────────────────────────────────────────────────────────────────
from components.navbar import render_navbar
render_navbar()

from components.snowflake_queries import get_claim_evolution, get_top_evolved_topics

# ── Drift colours ─────────────────────────────────────────────────────────────
DRIFT_COLORS = {
    "CONTRADICTED": "#f87171",
    "REVISED":      "#fbbf24",
    "SOFTENED":     "#818cf8",
    "ESCALATED":    "#f9a8d4",
    "CONFIRMED":    "#34d399",
}

DRIFT_BADGE_CLASS = {
    "CONTRADICTED": "badge-contradicted",
    "REVISED":      "badge-revised",
    "SOFTENED":     "badge-softened",
    "ESCALATED":    "badge-escalated",
    "CONFIRMED":    "badge-confirmed",
}

# ── Header ────────────────────────────────────────────────────────────────────
st.markdown('<div class="page-title">Claim Timeline</div>', unsafe_allow_html=True)
st.markdown(
    '<div class="page-subtitle">Track how opinions and predictions evolve across episodes over time.</div>',
    unsafe_allow_html=True,
)

# ── Topic selector ────────────────────────────────────────────────────────────
col_search, col_limit = st.columns([4, 1])

with col_search:
    topic_input = st.text_input(
        "Search topic",
        placeholder="e.g. AGI, crypto, longevity, AI safety...",
        label_visibility="collapsed",
    )
with col_limit:
    result_limit = st.selectbox("Show", [15, 30, 50], label_visibility="collapsed")

# ── Hot topics ────────────────────────────────────────────────────────────────
try:
    with st.spinner("Loading popular topics..."):
        hot_topics = get_top_evolved_topics(12)

    if hot_topics and not topic_input:
        st.markdown('<div class="section-label">Popular topics</div>', unsafe_allow_html=True)
        cols = st.columns(6)
        for i, t in enumerate(hot_topics[:12]):
            topic_name = t.get("TOPIC", "")
            evol_count = t.get("EVOLUTION_COUNT", 0)
            with cols[i % 6]:
                if st.button(
                    f"{topic_name[:18]}\n_{evol_count} evolutions_",
                    key=f"ht_{i}",
                    use_container_width=True,
                ):
                    st.session_state["selected_topic"] = topic_name
                    st.rerun()
except Exception:
    pass

active_topic = topic_input.strip() or st.session_state.get("selected_topic", "")

if active_topic:
    col_t, col_clr = st.columns([8, 1])
    with col_t:
        st.markdown(
            f'<div class="section-label">Showing evolution for: '
            f'<span style="color:#c4b5fd;">{active_topic}</span></div>',
            unsafe_allow_html=True,
        )
    with col_clr:
        if st.button("✕ Clear", key="clear_topic"):
            if "selected_topic" in st.session_state:
                del st.session_state["selected_topic"]
            st.rerun()

    with st.status(f'Searching claim evolution for "{active_topic}"...', expanded=False) as status:
        rows = get_claim_evolution(active_topic, result_limit)
        status.update(
            label=f"{len(rows)} evolution pairs found" if rows else "No evolution pairs found",
            state="complete" if rows else "error",
        )

    if not rows:
        st.info(f'No claim evolution data found for "{active_topic}". Try: "AI", "crypto", "health".')
    else:
        df = pd.DataFrame(rows)
        df.columns = [c.lower() for c in df.columns]
        df["original_date"] = pd.to_datetime(df.get("original_date"), errors="coerce")
        df["evolved_date"]  = pd.to_datetime(df.get("evolved_date"),  errors="coerce")
        df["drift_type"]    = df.get("drift_type", "REVISED").fillna("REVISED").str.upper()

        # ── Timeline scatter chart ─────────────────────────────────────────────
        fig = go.Figure()

        # Connecting lines
        for _, row in df.iterrows():
            if pd.notnull(row["original_date"]) and pd.notnull(row["evolved_date"]):
                color = DRIFT_COLORS.get(row["drift_type"], "#64748b")
                fig.add_trace(go.Scatter(
                    x=[row["original_date"], row["evolved_date"]],
                    y=[row.get("original_speaker", ""), row.get("evolved_speaker", "")],
                    mode="lines",
                    line=dict(color=color, width=1, dash="dot"),
                    showlegend=False,
                    hoverinfo="skip",
                ))

        # Original claims
        fig.add_trace(go.Scatter(
            x=df["original_date"],
            y=df.get("original_speaker", pd.Series([""] * len(df))),
            mode="markers",
            name="Original Claim",
            marker=dict(size=10, color="#475569", symbol="circle",
                        line=dict(width=1, color="rgba(255,255,255,.15)")),
            customdata=df[["original_text", "original_url", "drift_type",
                           "channel_original", "time_delta_days"]].values,
            hovertemplate=(
                "<b>Original Claim</b><br>"
                "%{customdata[0]:.100}<br>"
                "Channel: %{customdata[3]}<br>"
                "Drift: %{customdata[2]}<br>"
                "%{x|%b %Y}<extra></extra>"
            ),
        ))

        # Evolved claims by drift type
        for drift, color in DRIFT_COLORS.items():
            mask = df["drift_type"] == drift
            if mask.any():
                sub = df[mask]
                fig.add_trace(go.Scatter(
                    x=sub["evolved_date"],
                    y=sub.get("evolved_speaker", pd.Series([""] * len(sub))),
                    mode="markers",
                    name=drift.title(),
                    marker=dict(size=12, color=color, symbol="diamond",
                                line=dict(width=1, color="rgba(255,255,255,.2)")),
                    customdata=sub[["evolved_text", "evolved_url",
                                    "time_delta_days", "channel_evolved"]].values,
                    hovertemplate=(
                        f"<b>{drift.title()}</b><br>"
                        "%{customdata[0]:.100}<br>"
                        "Channel: %{customdata[3]}<br>"
                        "Gap: %{customdata[2]} days<br>"
                        "%{x|%b %Y}<extra></extra>"
                    ),
                ))

        fig.update_layout(
            height=420,
            margin=dict(l=0, r=0, t=10, b=40),
            paper_bgcolor="rgba(0,0,0,0)",
            plot_bgcolor="rgba(255,255,255,.02)",
            xaxis=dict(showgrid=True, gridcolor="rgba(255,255,255,.05)",
                       title="", color="#64748b",
                       tickfont=dict(color="#64748b")),
            yaxis=dict(showgrid=False, title="Speaker",
                       color="#64748b", tickfont=dict(color="#64748b")),
            legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="left", x=0,
                        font=dict(size=11, color="#94a3b8"),
                        bgcolor="rgba(0,0,0,0)", borderwidth=0),
            font=dict(family="Inter", size=11, color="#94a3b8"),
            hoverlabel=dict(bgcolor="#1e1b4b", bordercolor="rgba(109,40,217,.4)",
                            font=dict(family="Inter", size=12, color="#e2e8f0")),
        )
        st.plotly_chart(fig, use_container_width=True)

        # ── Drift breakdown + evolution cards ──────────────────────────────────
        drift_counts = df["drift_type"].value_counts().reset_index()
        drift_counts.columns = ["Drift Type", "Count"]
        drift_counts["Color"] = drift_counts["Drift Type"].map(DRIFT_COLORS).fillna("#64748b")

        col_pie, col_cards = st.columns([2, 3])

        with col_pie:
            fig_pie = go.Figure(go.Pie(
                labels=drift_counts["Drift Type"],
                values=drift_counts["Count"],
                marker_colors=drift_counts["Color"],
                hole=0.55,
                textinfo="label+percent",
                textfont=dict(size=11, color="#e2e8f0"),
            ))
            fig_pie.update_layout(
                height=260,
                margin=dict(l=0, r=0, t=10, b=10),
                paper_bgcolor="rgba(0,0,0,0)",
                showlegend=False,
                font=dict(family="Inter", color="#94a3b8"),
            )
            st.plotly_chart(fig_pie, use_container_width=True)

        with col_cards:
            st.markdown('<div class="section-label">Evolution Pairs</div>', unsafe_allow_html=True)
            for _, row in df.head(5).iterrows():
                drift     = row.get("drift_type", "REVISED")
                color     = DRIFT_COLORS.get(drift, "#64748b")
                badge_cls = DRIFT_BADGE_CLASS.get(drift, "badge-revised")
                orig_txt  = str(row.get("original_text", ""))[:180]
                evol_txt  = str(row.get("evolved_text",  ""))[:180]
                orig_spk  = row.get("original_speaker", "")
                evol_spk  = row.get("evolved_speaker",  "")
                orig_dt   = str(row.get("original_date", ""))[:10]
                evol_dt   = str(row.get("evolved_date",  ""))[:10]
                orig_url  = row.get("original_url", "")
                evol_url  = row.get("evolved_url", "")
                days      = row.get("time_delta_days", "")

                lo = f"<a class='rc-link' href='{orig_url}' target='_blank'>▶</a>" if orig_url else ""
                le = f"<a class='rc-link' href='{evol_url}' target='_blank'>▶</a>" if evol_url else ""

                st.markdown(f"""
<div class="result-card" style="border-left:3px solid {color};margin-bottom:0.6rem;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
    <span class="badge {badge_cls}">{drift}</span>
    <span style="font-size:0.7rem;color:#475569;">{days} days apart</span>
  </div>
  <div style="font-size:0.75rem;color:#475569;margin-bottom:0.2rem;">
    <b style="color:#64748b;">Before</b> · {orig_spk} · {orig_dt} {lo}
  </div>
  <div style="font-size:0.82rem;color:#94a3b8;margin-bottom:0.55rem;line-height:1.55;">{orig_txt}</div>
  <div style="font-size:0.75rem;color:#475569;margin-bottom:0.2rem;">
    <b style="color:#64748b;">After</b> · {evol_spk} · {evol_dt} {le}
  </div>
  <div style="font-size:0.82rem;color:#e2e8f0;line-height:1.55;">{evol_txt}</div>
</div>""", unsafe_allow_html=True)

else:
    st.markdown("""
<div style="text-align:center;padding:4rem 0;color:#334155;">
  <div style="font-size:2.5rem;margin-bottom:0.75rem;">⏳</div>
  <div style="font-size:1rem;font-weight:600;
    background:linear-gradient(135deg,#fff,#c4b5fd,#a855f7);
    -webkit-background-clip:text;-webkit-text-fill-color:transparent;
    background-clip:text;margin-bottom:0.5rem;">
    Search a topic to explore claim evolution
  </div>
  <div style="font-size:0.875rem;color:#475569;">
    Try: <span style="color:#7c3aed;">AGI</span> &nbsp;·&nbsp;
         <span style="color:#7c3aed;">crypto</span> &nbsp;·&nbsp;
         <span style="color:#7c3aed;">longevity</span> &nbsp;·&nbsp;
         <span style="color:#7c3aed;">AI safety</span>
  </div>
</div>
""", unsafe_allow_html=True)
